---
import { getCollection, type CollectionEntry } from 'astro:content';
import TopBar from '../../components/TopBar.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/global.css';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post }
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await post.render();
const dateStr = post.data.date.toLocaleDateString('en-GB', {
  year: 'numeric',
  month: 'short',
  day: 'numeric'
});
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{post.data.title} / daksh</title>
  <meta name="description" content={post.data.description} />
  <link rel="icon" type="image/png" href="https://github.com/h4shcore.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
</head>
<body>
  <TopBar />

  <article class="post">
    <a class="back-link" href="/blog">&larr; all posts</a>
    <div class="post-meta">
      <span>{dateStr}</span>
      {post.data.tags.map((t) => <span class="tag-chip">{t}</span>)}
    </div>
    <h1>{post.data.title}</h1>
    <div class="prose">
      <Content />
    </div>
  </article>

  <Footer />
</body>
</html>

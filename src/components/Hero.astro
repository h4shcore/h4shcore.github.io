<section class="ws" id="ws1">
  <div class="tag reveal">workspace 01 -> intro</div>
  <div class="bsp reveal">
    <div class="tile tile-master" id="hero-to-about" role="button" tabindex="0" aria-label="Jump to about section">
      <h1>daksh.</h1>
      <p>Chasing niche, obscure, and new: music, games, art, philosophy, tech.</p>
      <div class="role-line">$ whoami &rarr; probably in a rabbit hole rn</div>
    </div>
    <div class="stack">
      <div class="tile">
        <div class="stat-label">based in</div>
        <div class="stat-val">Nagpur, IN</div>
      </div>
      <div class="tile">
        <div class="stat-label">daily driver</div>
        <div class="stat-val">NixOS + Niri</div>
      </div>
    </div>
  </div>
</section>

<script>
  const heroMaster = document.getElementById('hero-to-about');
  const jumpToAbout = () => {
    document.getElementById('ws2')?.scrollIntoView({ behavior: 'smooth' });
  };
  heroMaster?.addEventListener('click', jumpToAbout);
  heroMaster?.addEventListener('keydown', (e) => {
    if (e instanceof KeyboardEvent && (e.key === 'Enter' || e.key === ' ')) {
      e.preventDefault();
      jumpToAbout();
    }
  });
</script>

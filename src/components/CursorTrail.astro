<div id="cursor-ring" class="cursor-ring"></div>

<script>
  const ring = document.getElementById("cursor-ring")!;

  let mouseX = 0, mouseY = 0;
  let x = 0, y = 0;
  let vx = 0, vy = 0;
  let visible = false;

  const stiffness = 0.12;
  const damping = 0.72;

  window.addEventListener("mousemove", (e) => {
    mouseX = e.clientX;
    mouseY = e.clientY;
    if (!visible) {
      x = mouseX;
      y = mouseY;
      ring.style.opacity = "1";
      visible = true;
    }
  });

  window.addEventListener("mouseleave", () => {
    ring.style.opacity = "0";
    visible = false;
  });

  function tick() {
    const dx = mouseX - x;
    const dy = mouseY - y;

    vx += dx * stiffness;
    vy += dy * stiffness;

    vx *= damping;
    vy *= damping;

    x += vx;
    y += vy;

    const speed = Math.sqrt(vx * vx + vy * vy);
    const stretch = Math.min(speed * 0.04, 0.6);
    const angle = Math.atan2(vy, vx) * (180 / Math.PI);

    ring.style.transform = `translate(${x}px, ${y}px) translate(-50%, -50%) rotate(${angle}deg) scaleX(${1 + stretch}) scaleY(${1 - stretch * 0.4})`;

    requestAnimationFrame(tick);
  }
  tick();

  const hoverTargets = document.querySelectorAll("a, button, .copyable");
  hoverTargets.forEach((el) => {
    el.addEventListener("mouseenter", () => ring.classList.add("cursor-ring--active"));
    el.addEventListener("mouseleave", () => ring.classList.remove("cursor-ring--active"));
  });
</script>
